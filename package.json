{
  "name": "desktop-pet",
  "version": "1.0.0",
  "description": "一只可以 DIY 的桌面宠物",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "author": "you",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.yourname.desktoppet",
    "productName": "DesktopPet",
    "files": [
      "main.js",
      "assistant-core.js",
      "assistant-preload.js",
      "system-activity.js",
      "preload.js",
      "config.json",
      "assets/**/*",
      "renderer/**/*",
      "assistant/**/*",
      "plugins/**/*"
    ],
    "asarUnpack": [
      "node_modules/get-windows/lib/binding/**/*.node"
    ],
    "npmRebuild": false,
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "portable",
      "signAndEditExecutable": false,
      "extraResources": [
        {
          "from": "node_modules/windows-media-sessions/bin/win-x64/windows-media-sessions-backend.exe",
          "to": "activity-backend/windows-media-sessions-backend.exe"
        }
      ]
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "get-windows": "^9.3.0"
  },
  "optionalDependencies": {
    "windows-media-sessions": "^1.0.3"
  }
}
