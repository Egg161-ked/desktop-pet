{
  "name": "desktop-pet",
  "version": "1.0.0",
  "description": "一只可以 DIY 的桌面宠物",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "author": "you",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.yourname.desktoppet",
    "productName": "DesktopPet",
    "files": ["main.js", "preload.js", "config.json", "renderer/**/*", "plugins/**/*"],
    "mac": { "target": "dmg" },
    "win": { "target": "portable" },
    "linux": { "target": "AppImage" }
  }
}
